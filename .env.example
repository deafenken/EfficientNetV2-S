# Kaggle credentials — copy to `.env` (gitignored) OR place files under ~/.kaggle/.
# Resolver + rationale: scripts/kaggle/auth.py · docs/SUBMISSION_WORKFLOW.md
#
# NEVER commit real credentials. `.env`, kaggle.json, and access_token are
# gitignored; only this .env.example (placeholders) is tracked.

# --- Legacy json equivalents -------------------------------------------------
# Needed for `kaggle kernels push` and `kaggle competitions submit`.
# (Equivalent to ~/.kaggle/kaggle.json {"username","key"}.)
KAGGLE_USERNAME=
KAGGLE_KEY=

# --- Personal Access Token ---------------------------------------------------
# Needed for kagglehub dataset uploads (the PAT canNOT push kernels — that is
# why the split-stack above also exists). Or place it at ~/.kaggle/access_token.
KAGGLE_API_TOKEN=
